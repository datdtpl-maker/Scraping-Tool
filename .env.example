# Cấu hình Gemini API (Gemini 2.5 Flash / Gemini 3.8 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Cấu hình Serper.dev API (Tùy chọn nếu muốn cào SERP Google nâng cao)
SERPER_API_KEY=your_serper_api_key_here

# Đường dẫn lưu trữ SQLite Database local
DATABASE_PATH=product_opportunities.db
